#!/usr/bin/env bash
set -euo pipefail

ASDF_TOOLS=(erlang elixir python nodejs)
ALL_TOOLS=("${ASDF_TOOLS[@]}")
FLATPAK_APPS=(com.bambulab.BambuStudio com.todoist.Todoist org.freecad.FreeCAD md.obsidian.Obsidian)
# Global npm packages, installed into the asdf Node.js.
NPM_PACKAGES=(pnpm typescript wrangler)
SNAP_APPS=(postman)
DOCKER_PACKAGES=(docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)
# pdflatex plus the packages docs/devtools.tex needs (tikz, listings, booktabs, enumitem, lmodern).
LATEX_PACKAGES=(texlive-latex-base texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended latexmk)

# Optional steps, each skippable with --no-<step> and run by setup_<step> (dashes become underscores).
# EARLY_STEPS run before asdf and its tools, LATE_STEPS after.
EARLY_STEPS=(system zsh)
LATE_STEPS=(npm vscode sublime-merge gh 1password latex flatpak snap claude claude-desktop
            docker kubectl helm terraform terragrunt aws)
STEPS=("${EARLY_STEPS[@]}" "${LATE_STEPS[@]}")
declare -A ENABLED
for step in "${STEPS[@]}"; do ENABLED[$step]=1; done
SELECTED=()

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m  %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
unknown() { die "unknown argument: $1 (known tools: ${ALL_TOOLS[*]})"; }

# contains NEEDLE ITEM...: succeed if NEEDLE is one of the ITEMs.
contains() {
    local needle=$1 item; shift
    for item; do [ "$item" = "$needle" ] && return 0; done
    return 1
}

usage() {
    printf 'Usage: devtools'
    printf ' [--no-%s]' "${STEPS[@]}"
    printf ' [tool ...]\n'
}

for arg in "$@"; do
    case "$arg" in
        --no-*)
            step=${arg#--no-}
            if [ -z "$step" ] || [ -z "${ENABLED[$step]+set}" ]; then unknown "$arg"; fi
            ENABLED[$step]=0 ;;
        -h|--help)
            usage
            exit 0 ;;
        *)
            contains "$arg" "${ALL_TOOLS[@]}" || unknown "$arg"
            SELECTED+=("$arg") ;;
    esac
done
if [ "${#SELECTED[@]}" -gt 0 ]; then
    # Filter ALL_TOOLS rather than copying SELECTED: elixir's version depends on erlang running first.
    ASDF_TOOLS=()
    for t in "${ALL_TOOLS[@]}"; do
        contains "$t" "${SELECTED[@]}" && ASDF_TOOLS+=("$t")
    done
    for step in "${STEPS[@]}"; do [ "$step" = system ] || ENABLED[$step]=0; done
fi

# Print the CPU architecture as Debian names it (amd64 or arm64), or die.
cpu_arch() {
    case "$(uname -m)" in
        x86_64) echo amd64 ;;
        aarch64|arm64) echo arm64 ;;
        *) die "unsupported architecture $(uname -m)" ;;
    esac
}

# Print the Ubuntu release codename (e.g. noble), for vendor repos that have one suite per release.
os_codename() {
    # shellcheck source=/dev/null
    (. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
}

# Print the tag of a GitHub repo's latest release (OWNER/REPO), by following the /releases/latest redirect.
latest_github_tag() {
    curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" | sed 's|.*/||'
}

# Fail (with a warning) when CMD is on PATH but not from deb PKG, so a copy installed
# some other way is left alone: `apt_owns LABEL CMD PKG || return`
apt_owns() {
    local label=$1 cmd=$2 pkg=$3
    if have "$cmd" && ! dpkg -s "$pkg" >/dev/null 2>&1; then
        warn "[$label] managed elsewhere ($(command -v "$cmd")), not touching it"
        return 1
    fi
}

# Run a command as root, through sudo unless we already are root.
as_root() {
    if [ "$EUID" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

# Warn and return non-zero when apt-get is unavailable: `need_apt "msg" || return`
need_apt() { have apt-get || { warn "apt-get not found, $1"; return 1; }; }

apt_update() { as_root apt-get update -qq; }

# Install a deb package, or upgrade it if already installed.
apt_install_or_upgrade() {
    local label=$1 pkg=$2
    if dpkg -s "$pkg" >/dev/null 2>&1; then
        log "[$label] installed ($(dpkg-query -W -f='${Version}' "$pkg")), upgrading"
        as_root apt-get install -y --only-upgrade "$pkg"
    else
        log "[$label] installing"
        as_root apt-get install -y "$pkg"
    fi
}

# Add an apt repo unless REPO.sources/REPO.list already exists, then refresh apt.
# The deb822 sources text is read from stdin.
# Usage: ensure_apt_repo LABEL VENDOR REPO KEY_URL KEYRING KEY_FILTER <<EOF ... EOF
ensure_apt_repo() {
    local label=$1 vendor=$2 list=/etc/apt/sources.list.d/$3 key_url=$4 keyring=$5 key_filter=$6
    if [ ! -f "$list.sources" ] && [ ! -f "$list.list" ]; then
        log "[$label] adding $vendor apt repository"
        as_root mkdir -p "${keyring%/*}"
        # KEY_FILTER is a command line (e.g. "gpg --dearmor"), so it is split into words on purpose.
        # shellcheck disable=SC2086
        curl -fsSL "$key_url" | $key_filter | as_root tee "$keyring" >/dev/null
        as_root tee "$list.sources" >/dev/null
    fi
    apt_update
}

# Download a script to a temp file and run it: run_remote_script URL INTERPRETER [SCRIPT_ARGS...]
# Runs `INTERPRETER TMPFILE SCRIPT_ARGS...`, so the args go to the script, not the interpreter.
run_remote_script() {
    local url=$1 interpreter=$2 tmp; shift 2
    tmp=$(mktemp)
    curl -fsSL "$url" -o "$tmp"
    "$interpreter" "$tmp" "$@"
    rm -f "$tmp"
}

setup_system() {
    need_apt "skipping system build deps" || return
    log "Installing build dependencies (apt)"
    apt_update
    as_root apt-get install -y --no-install-recommends \
        build-essential autoconf m4 curl git ca-certificates gpg wget unzip \
        libssl-dev libncurses-dev libreadline-dev libffi-dev zlib1g-dev libbz2-dev \
        libsqlite3-dev liblzma-dev libgdbm-dev tk-dev uuid-dev xz-utils \
        libwxgtk3.2-dev libgl1-mesa-dev libglu1-mesa-dev libssh-dev unixodbc-dev \
        libxml2-utils xsltproc fop
}

setup_zsh() {
    need_apt "install zsh manually" || return
    apt_update
    apt_install_or_upgrade zsh zsh

    local user zsh_path login_shell
    user=$(id -un)
    zsh_path=$(command -v zsh)
    login_shell=$(getent passwd "$user" | cut -d: -f7)
    if [ "${login_shell##*/}" = zsh ]; then
        log "[zsh] already the login shell for $user"
    else
        log "[zsh] making it the login shell for $user (takes effect at next login)"
        as_root chsh -s "$zsh_path" "$user"
    fi

    have git || die "git is needed for oh-my-zsh (install it or drop --no-system)"
    local omz="${ZSH:-$HOME/.oh-my-zsh}"
    if [ -d "$omz/.git" ]; then
        log "[oh-my-zsh] present, updating"
        ZSH="$omz" zsh -f "$omz/tools/upgrade.sh" -v minimal || warn "[oh-my-zsh] update failed, continuing"
    elif [ -e "$omz" ]; then
        warn "[oh-my-zsh] $omz exists but is not a git checkout, not touching it"
    else
        log "[oh-my-zsh] installing to $omz"
        ZSH="$omz" run_remote_script https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh \
            sh --unattended
    fi
}

ensure_asdf() {
    export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
    export PATH="$HOME/.local/bin:$ASDF_DATA_DIR/shims:$PATH"
    local arch latest_tag current="" dir="$HOME/.local/bin" tmp
    arch=$(cpu_arch)
    latest_tag=$(latest_github_tag asdf-vm/asdf)
    [ -n "$latest_tag" ] || die "could not determine latest asdf release"

    have asdf && current=$(asdf --version | awk '{print $3}' | sed 's/,$//; s/^\(v\)\?/v/')
    if [ "$current" = "$latest_tag" ]; then
        log "asdf $current is up to date"
    elif have asdf && [ "$(command -v asdf)" != "$dir/asdf" ]; then
        warn "asdf $current is managed elsewhere ($(command -v asdf)); latest is $latest_tag, not touching it"
    else
        log "Installing asdf $latest_tag to $dir"
        mkdir -p "$dir"
        tmp=$(mktemp -d)
        curl -fsSL "https://github.com/asdf-vm/asdf/releases/download/${latest_tag}/asdf-${latest_tag}-linux-${arch}.tar.gz" \
            | tar -xz -C "$tmp"
        install -m 0755 "$tmp/asdf" "$dir/asdf"
        rm -rf "$tmp"
    fi
    setup_shell_rc
    hash -r
}

setup_shell_rc() {
    local marker="# >>> devtools asdf >>>" rc
    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        [ "$rc" = "$HOME/.zshrc" ] && ! have zsh && continue
        touch "$rc"
        grep -qF "$marker" "$rc" && continue
        cat >>"$rc" <<'RC'
# >>> devtools asdf >>>
export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$HOME/.local/bin:$ASDF_DATA_DIR/shims:$PATH"
# <<< devtools asdf <<<
RC
        log "Added asdf PATH setup to $rc"
    done
}

asdf_set_global() {
    local tool=$1 version=$2
    if asdf set --help >/dev/null 2>&1; then
        asdf set --home "$tool" "$version"
    else
        asdf global "$tool" "$version"
    fi
}

latest_version() {
    local tool=$1 v
    case "$tool" in
        python)
            v=$(asdf list all python | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n1) ;;
        elixir)
            [ -n "${ERL_MAJOR:-}" ] || ERL_MAJOR=$(asdf latest erlang | cut -d. -f1)
            v=$(asdf list all elixir | grep -E '^[0-9]+\.[0-9]+\.[0-9]+-otp-[0-9]+$' \
                | awk -F'-otp-' -v max="$ERL_MAJOR" '$2<=max' | sort -V | tail -n1) ;;
        *)
            v=$(asdf latest "$tool") ;;
    esac
    [ -n "$v" ] || die "could not resolve latest $tool"
    printf '%s\n' "$v"
}

manage_tool() {
    local tool=$1 latest
    if asdf plugin list 2>/dev/null | grep -qx "$tool"; then
        log "[$tool] plugin present, updating"
        asdf plugin update "$tool" >/dev/null 2>&1 || warn "[$tool] plugin update failed, continuing"
    else
        log "[$tool] plugin missing, adding"
        asdf plugin add "$tool"
    fi

    latest=$(latest_version "$tool")
    if asdf list "$tool" 2>/dev/null | sed 's/^[ *]*//' | grep -qx "$latest"; then
        log "[$tool] $latest already installed"
    else
        log "[$tool] installing $latest (this can take a while for erlang/python)"
        asdf install "$tool" "$latest"
    fi
    asdf_set_global "$tool" "$latest"
    [ "$tool" = erlang ] && ERL_MAJOR=${latest%%.*}
    asdf reshim "$tool" >/dev/null 2>&1 || true
}

report_asdf() {
    log "asdf versions now active:"
    local t
    for t in "${ASDF_TOOLS[@]}"; do
        printf '  %-8s %s\n' "$t" "$(asdf current "$t" 2>/dev/null | awk 'NR==1 && $1=="Name"{next} {print $2; exit}')"
    done
}

setup_vscode() {
    need_apt "install VS Code manually" || return
    local keyring=/usr/share/keyrings/microsoft.gpg
    ensure_apt_repo vscode Microsoft vscode https://packages.microsoft.com/keys/microsoft.asc "$keyring" "gpg --dearmor" <<EOF
Types: deb
URIs: https://packages.microsoft.com/repos/code
Suites: stable
Components: main
Architectures: amd64,arm64,armhf
Signed-By: $keyring
EOF
    apt_install_or_upgrade vscode code
}

setup_sublime_merge() {
    need_apt "install Sublime Merge manually" || return
    local keyring=/etc/apt/keyrings/sublimehq-pub.asc
    ensure_apt_repo sublime-merge "Sublime HQ" sublime-text https://download.sublimetext.com/sublimehq-pub.gpg "$keyring" cat <<EOF
Types: deb
URIs: https://download.sublimetext.com/
Suites: apt/stable/
Signed-By: $keyring
EOF
    apt_install_or_upgrade sublime-merge sublime-merge
}

setup_gh() {
    need_apt "install the GitHub CLI manually" || return
    local keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg
    ensure_apt_repo gh GitHub github-cli https://cli.github.com/packages/githubcli-archive-keyring.gpg "$keyring" cat <<EOF
Types: deb
URIs: https://cli.github.com/packages
Suites: stable
Components: main
Signed-By: $keyring
EOF
    apt_install_or_upgrade gh gh
}

setup_1password() {
    need_apt "install 1Password manually" || return
    # 1Password's apt repository only ships amd64 builds.
    [ "$(dpkg --print-architecture)" = amd64 ] || { warn "[1password] no apt package for $(dpkg --print-architecture), skipping"; return; }
    local keyring=/usr/share/keyrings/1password-archive-keyring.gpg
    ensure_apt_repo 1password 1Password 1password https://downloads.1password.com/linux/keys/1password.asc "$keyring" "gpg --dearmor" <<EOF
Types: deb
URIs: https://downloads.1password.com/linux/debian/amd64
Suites: stable
Components: main
Architectures: amd64
Signed-By: $keyring
EOF
    apt_install_or_upgrade 1password 1password
    apt_install_or_upgrade 1password 1password-cli
}

setup_latex() {
    need_apt "install TeX Live manually" || return
    apt_update
    local pkg
    for pkg in "${LATEX_PACKAGES[@]}"; do apt_install_or_upgrade latex "$pkg"; done
}

setup_flatpak() {
    need_apt "install flatpak manually" || return
    if ! have flatpak; then
        log "[flatpak] installing"
        as_root apt-get install -y flatpak
    fi
    if ! flatpak remotes --columns=name 2>/dev/null | grep -qx flathub; then
        log "[flatpak] adding flathub remote"
        as_root flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    local app
    for app in "${FLATPAK_APPS[@]}"; do
        if flatpak info "$app" >/dev/null 2>&1; then
            log "[flatpak] $app installed, updating"
            as_root flatpak update -y --noninteractive "$app"
        else
            log "[flatpak] installing $app"
            as_root flatpak install -y --noninteractive flathub "$app"
        fi
    done
}

setup_claude() {
    local bin="$HOME/.local/bin/claude"
    if [ -L "$bin" ] && [[ "$(readlink -f "$bin")" == "$HOME/.local/share/claude/"* ]]; then
        log "[claude] installed, checking for updates"
        "$bin" update </dev/null || warn "[claude] update failed, continuing"
    elif have claude; then
        warn "[claude] managed elsewhere ($(command -v claude)), not touching it"
    else
        log "[claude] installing"
        run_remote_script https://claude.ai/install.sh bash </dev/null
    fi
}

setup_npm() {
    have npm || { warn "[npm] npm not found (is nodejs in ASDF_TOOLS?), skipping"; return; }
    local pkg path
    for pkg in "${NPM_PACKAGES[@]}"; do
        path=$(command -v "$pkg" 2>/dev/null || true)
        # wrangler installs the `wrangler` command, typescript installs `tsc`.
        [ "$pkg" = typescript ] && path=$(command -v tsc 2>/dev/null || true)
        if [ -n "$path" ] && [[ "$path" != "$ASDF_DATA_DIR/shims/"* ]]; then
            warn "[npm] $pkg managed elsewhere ($path), not touching it"
            continue
        fi
        log "[npm] installing or updating $pkg"
        npm install -g --no-fund --no-audit "$pkg@latest"
    done
    asdf reshim nodejs >/dev/null 2>&1 || true
}

setup_snap() {
    have snap || { warn "[snap] snapd not found, skipping ${SNAP_APPS[*]}"; return; }
    local app
    for app in "${SNAP_APPS[@]}"; do
        if snap list "$app" >/dev/null 2>&1; then
            log "[snap] $app installed, refreshing"
            as_root snap refresh "$app"
        else
            log "[snap] installing $app"
            as_root snap install "$app"
        fi
    done
}

setup_claude_desktop() {
    need_apt "install the Claude desktop app manually" || return
    local keyring=/usr/share/keyrings/claude-desktop-archive-keyring.asc
    ensure_apt_repo claude-desktop Anthropic claude-desktop https://downloads.claude.ai/claude-desktop/key.asc "$keyring" cat <<EOF
Types: deb
URIs: https://downloads.claude.ai/claude-desktop/apt/stable
Suites: stable
Components: main
Architectures: amd64,arm64
Signed-By: $keyring
EOF
    apt_install_or_upgrade claude-desktop claude-desktop
}

setup_docker() {
    need_apt "install Docker manually" || return
    apt_owns docker docker docker-ce || return
    local keyring=/etc/apt/keyrings/docker.asc pkg user
    ensure_apt_repo docker Docker docker https://download.docker.com/linux/ubuntu/gpg "$keyring" cat <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(os_codename)
Components: stable
Signed-By: $keyring
EOF
    for pkg in "${DOCKER_PACKAGES[@]}"; do apt_install_or_upgrade docker "$pkg"; done

    user=$(id -un)
    if [ "$EUID" -ne 0 ] && ! id -nG "$user" | tr ' ' '\n' | grep -qx docker; then
        log "[docker] adding $user to the docker group (takes effect at next login)"
        as_root usermod -aG docker "$user"
    fi
}

setup_kubectl() {
    need_apt "install kubectl manually" || return
    apt_owns kubectl kubectl kubectl || return
    # pkgs.k8s.io has one repository per minor release, so follow the current stable minor.
    local minor keyring=/etc/apt/keyrings/kubernetes-apt-keyring.gpg list=/etc/apt/sources.list.d/kubernetes
    minor=$(curl -fsSL https://dl.k8s.io/release/stable.txt | cut -d. -f1,2)
    [ -n "$minor" ] || die "[kubectl] could not determine the stable Kubernetes release"
    if [ -f "$list.sources" ] && ! grep -q "/$minor/" "$list.sources"; then
        log "[kubectl] moving apt repository to $minor"
        as_root rm -f "$list.sources"
    fi
    ensure_apt_repo kubectl Kubernetes kubernetes "https://pkgs.k8s.io/core:/stable:/$minor/deb/Release.key" "$keyring" "gpg --dearmor" <<EOF
Types: deb
URIs: https://pkgs.k8s.io/core:/stable:/$minor/deb/
Suites: /
Signed-By: $keyring
EOF
    apt_install_or_upgrade kubectl kubectl
}

setup_helm() {
    need_apt "install Helm manually" || return
    apt_owns helm helm helm || return
    local keyring=/usr/share/keyrings/helm.gpg
    ensure_apt_repo helm Helm helm-stable-debian https://packages.buildkite.com/helm-linux/helm-debian/gpgkey "$keyring" "gpg --dearmor" <<EOF
Types: deb
URIs: https://packages.buildkite.com/helm-linux/helm-debian/any/
Suites: any
Components: main
Signed-By: $keyring
EOF
    apt_install_or_upgrade helm helm
}

setup_terraform() {
    need_apt "install Terraform manually" || return
    apt_owns terraform terraform terraform || return
    local keyring=/usr/share/keyrings/hashicorp-archive-keyring.gpg
    ensure_apt_repo terraform HashiCorp hashicorp https://apt.releases.hashicorp.com/gpg "$keyring" "gpg --dearmor" <<EOF
Types: deb
URIs: https://apt.releases.hashicorp.com
Suites: $(os_codename)
Components: main
Signed-By: $keyring
EOF
    apt_install_or_upgrade terraform terraform
}

setup_terragrunt() {
    local bin="$HOME/.local/bin/terragrunt" latest current="" asset tmp
    if have terragrunt && [ "$(command -v terragrunt)" != "$bin" ]; then
        warn "[terragrunt] managed elsewhere ($(command -v terragrunt)), not touching it"
        return
    fi
    latest=$(latest_github_tag gruntwork-io/terragrunt)
    [ -n "$latest" ] || die "[terragrunt] could not determine latest release"
    [ -x "$bin" ] && current=$("$bin" --version | grep -oE 'v[0-9][^ ]*' | head -n1)
    if [ "$current" = "$latest" ]; then
        log "[terragrunt] $current is up to date"
        return
    fi
    log "[terragrunt] installing $latest to $bin"
    asset="terragrunt_linux_$(cpu_arch)"
    tmp=$(mktemp -d)
    curl -fsSL -o "$tmp/$asset" "https://github.com/gruntwork-io/terragrunt/releases/download/$latest/$asset"
    curl -fsSL -o "$tmp/SHA256SUMS" "https://github.com/gruntwork-io/terragrunt/releases/download/$latest/SHA256SUMS"
    (cd "$tmp" && grep " $asset\$" SHA256SUMS | sha256sum -c --quiet) || die "[terragrunt] checksum mismatch"
    mkdir -p "${bin%/*}"
    install -m 0755 "$tmp/$asset" "$bin"
    rm -rf "$tmp"
}

setup_aws() {
    # AWS's installer puts the CLI in /usr/local/aws-cli and links /usr/local/bin/aws; --update replaces it.
    local bin=/usr/local/bin/aws arch tmp
    if have aws && [ "$(command -v aws)" != "$bin" ]; then
        warn "[aws] managed elsewhere ($(command -v aws)), not touching it"
        return
    fi
    case "$(cpu_arch)" in amd64) arch=x86_64 ;; arm64) arch=aarch64 ;; esac
    log "[aws] installing or updating the AWS CLI"
    tmp=$(mktemp -d)
    curl -fsSL -o "$tmp/awscliv2.zip" "https://awscli.amazonaws.com/awscli-exe-linux-$arch.zip"
    unzip -q "$tmp/awscliv2.zip" -d "$tmp"
    as_root "$tmp/aws/install" --update
    rm -rf "$tmp"
}

# Run each enabled step through its setup_<step> function.
run_steps() {
    local step
    for step; do
        if [ "${ENABLED[$step]}" -eq 1 ]; then
            "setup_${step//-/_}"
        fi
    done
}

run_steps "${EARLY_STEPS[@]}"
ensure_asdf
for t in "${ASDF_TOOLS[@]}"; do manage_tool "$t"; done
run_steps "${LATE_STEPS[@]}"
report_asdf
log "Done."
