#!/usr/bin/env bash
set -euo pipefail

ASDF_TOOLS=(erlang elixir python)
ALL_TOOLS=("${ASDF_TOOLS[@]}")
FLATPAK_APPS=(com.bambulab.BambuStudio)

# Optional steps, each skippable with --no-<step> and run by setup_<step> (dashes become underscores).
# EARLY_STEPS run before asdf and its tools, LATE_STEPS after.
EARLY_STEPS=(system zsh)
LATE_STEPS=(vscode sublime-merge gh flatpak claude)
STEPS=("${EARLY_STEPS[@]}" "${LATE_STEPS[@]}")
declare -A ENABLED
for step in "${STEPS[@]}"; do ENABLED[$step]=1; done
SELECTED=()

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m  %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
unknown() { die "unknown argument: $1 (known tools: ${ALL_TOOLS[*]})"; }

# contains NEEDLE ITEM...: succeed if NEEDLE is one of the ITEMs.
contains() {
    local needle=$1 item; shift
    for item; do [ "$item" = "$needle" ] && return 0; done
    return 1
}

usage() {
    printf 'Usage: devtools'
    printf ' [--no-%s]' "${STEPS[@]}"
    printf ' [tool ...]\n'
}

for arg in "$@"; do
    case "$arg" in
        --no-*)
            step=${arg#--no-}
            [ -n "$step" ] && [ -n "${ENABLED[$step]+set}" ] || unknown "$arg"
            ENABLED[$step]=0 ;;
        -h|--help)
            usage
            exit 0 ;;
        *)
            contains "$arg" "${ALL_TOOLS[@]}" || unknown "$arg"
            SELECTED+=("$arg") ;;
    esac
done
if [ "${#SELECTED[@]}" -gt 0 ]; then
    # Filter ALL_TOOLS rather than copying SELECTED: elixir's version depends on erlang running first.
    ASDF_TOOLS=()
    for t in "${ALL_TOOLS[@]}"; do
        contains "$t" "${SELECTED[@]}" && ASDF_TOOLS+=("$t")
    done
    for step in "${STEPS[@]}"; do [ "$step" = system ] || ENABLED[$step]=0; done
fi

# Run a command as root, through sudo unless we already are root.
as_root() {
    if [ "$EUID" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

# Warn and return non-zero when apt-get is unavailable: `need_apt "msg" || return`
need_apt() { have apt-get || { warn "apt-get not found, $1"; return 1; }; }

apt_update() { as_root apt-get update -qq; }

# Install a deb package, or upgrade it if already installed.
apt_install_or_upgrade() {
    local label=$1 pkg=$2
    if dpkg -s "$pkg" >/dev/null 2>&1; then
        log "[$label] installed ($(dpkg-query -W -f='${Version}' "$pkg")), upgrading"
        as_root apt-get install -y --only-upgrade "$pkg"
    else
        log "[$label] installing"
        as_root apt-get install -y "$pkg"
    fi
}

# Add an apt repo unless REPO.sources/REPO.list already exists, then refresh apt.
# The deb822 sources text is read from stdin.
# Usage: ensure_apt_repo LABEL VENDOR REPO KEY_URL KEYRING KEY_FILTER <<EOF ... EOF
ensure_apt_repo() {
    local label=$1 vendor=$2 list=/etc/apt/sources.list.d/$3 key_url=$4 keyring=$5 key_filter=$6
    if [ ! -f "$list.sources" ] && [ ! -f "$list.list" ]; then
        log "[$label] adding $vendor apt repository"
        as_root mkdir -p "${keyring%/*}"
        # KEY_FILTER is a command line (e.g. "gpg --dearmor"), so it is split into words on purpose.
        # shellcheck disable=SC2086
        curl -fsSL "$key_url" | $key_filter | as_root tee "$keyring" >/dev/null
        as_root tee "$list.sources" >/dev/null
    fi
    apt_update
}

# Download a script to a temp file and run it: run_remote_script URL INTERPRETER [ARGS...]
run_remote_script() {
    local url=$1 tmp; shift
    tmp=$(mktemp)
    curl -fsSL "$url" -o "$tmp"
    "$@" "$tmp"
    rm -f "$tmp"
}

setup_system() {
    need_apt "skipping system build deps" || return
    log "Installing build dependencies (apt)"
    apt_update
    as_root apt-get install -y --no-install-recommends \
        build-essential autoconf m4 curl git ca-certificates gpg wget unzip \
        libssl-dev libncurses-dev libreadline-dev libffi-dev zlib1g-dev libbz2-dev \
        libsqlite3-dev liblzma-dev libgdbm-dev tk-dev uuid-dev xz-utils \
        libwxgtk3.2-dev libgl1-mesa-dev libglu1-mesa-dev libssh-dev unixodbc-dev \
        libxml2-utils xsltproc fop
}

setup_zsh() {
    need_apt "install zsh manually" || return
    apt_update
    apt_install_or_upgrade zsh zsh

    local user zsh_path login_shell
    user=$(id -un)
    zsh_path=$(command -v zsh)
    login_shell=$(getent passwd "$user" | cut -d: -f7)
    if [ "${login_shell##*/}" = zsh ]; then
        log "[zsh] already the login shell for $user"
    else
        log "[zsh] making it the login shell for $user (takes effect at next login)"
        as_root chsh -s "$zsh_path" "$user"
    fi

    have git || die "git is needed for oh-my-zsh (install it or drop --no-system)"
    local omz="${ZSH:-$HOME/.oh-my-zsh}"
    if [ -d "$omz/.git" ]; then
        log "[oh-my-zsh] present, updating"
        ZSH="$omz" zsh -f "$omz/tools/upgrade.sh" -v minimal || warn "[oh-my-zsh] update failed, continuing"
    elif [ -e "$omz" ]; then
        warn "[oh-my-zsh] $omz exists but is not a git checkout, not touching it"
    else
        log "[oh-my-zsh] installing to $omz"
        ZSH="$omz" run_remote_script https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh \
            sh --unattended
    fi
}

ensure_asdf() {
    export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
    export PATH="$HOME/.local/bin:$ASDF_DATA_DIR/shims:$PATH"
    local arch latest_tag current="" dir="$HOME/.local/bin" tmp
    case "$(uname -m)" in
        x86_64) arch=amd64 ;;
        aarch64|arm64) arch=arm64 ;;
        *) die "unsupported architecture $(uname -m)" ;;
    esac

    latest_tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
        https://github.com/asdf-vm/asdf/releases/latest | sed 's|.*/||')
    [ -n "$latest_tag" ] || die "could not determine latest asdf release"

    have asdf && current=$(asdf --version | awk '{print $3}' | sed 's/,$//; s/^\(v\)\?/v/')
    if [ "$current" = "$latest_tag" ]; then
        log "asdf $current is up to date"
    elif have asdf && [ "$(command -v asdf)" != "$dir/asdf" ]; then
        warn "asdf $current is managed elsewhere ($(command -v asdf)); latest is $latest_tag, not touching it"
    else
        log "Installing asdf $latest_tag to $dir"
        mkdir -p "$dir"
        tmp=$(mktemp -d)
        curl -fsSL "https://github.com/asdf-vm/asdf/releases/download/${latest_tag}/asdf-${latest_tag}-linux-${arch}.tar.gz" \
            | tar -xz -C "$tmp"
        install -m 0755 "$tmp/asdf" "$dir/asdf"
        rm -rf "$tmp"
    fi
    setup_shell_rc
    hash -r
}

setup_shell_rc() {
    local marker="# >>> devtools asdf >>>" rc
    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        [ "$rc" = "$HOME/.zshrc" ] && ! have zsh && continue
        touch "$rc"
        grep -qF "$marker" "$rc" && continue
        cat >>"$rc" <<'RC'
# >>> devtools asdf >>>
export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$HOME/.local/bin:$ASDF_DATA_DIR/shims:$PATH"
# <<< devtools asdf <<<
RC
        log "Added asdf PATH setup to $rc"
    done
}

asdf_set_global() {
    local tool=$1 version=$2
    if asdf set --help >/dev/null 2>&1; then
        asdf set --home "$tool" "$version"
    else
        asdf global "$tool" "$version"
    fi
}

latest_version() {
    local tool=$1 v
    case "$tool" in
        python)
            v=$(asdf list all python | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n1) ;;
        elixir)
            [ -n "${ERL_MAJOR:-}" ] || ERL_MAJOR=$(asdf latest erlang | cut -d. -f1)
            v=$(asdf list all elixir | grep -E '^[0-9]+\.[0-9]+\.[0-9]+-otp-[0-9]+$' \
                | awk -F'-otp-' -v max="$ERL_MAJOR" '$2<=max' | sort -V | tail -n1) ;;
        *)
            v=$(asdf latest "$tool") ;;
    esac
    [ -n "$v" ] || die "could not resolve latest $tool"
    printf '%s\n' "$v"
}

manage_tool() {
    local tool=$1 latest
    if asdf plugin list 2>/dev/null | grep -qx "$tool"; then
        log "[$tool] plugin present, updating"
        asdf plugin update "$tool" >/dev/null 2>&1 || warn "[$tool] plugin update failed, continuing"
    else
        log "[$tool] plugin missing, adding"
        asdf plugin add "$tool"
    fi

    latest=$(latest_version "$tool")
    if asdf list "$tool" 2>/dev/null | sed 's/^[ *]*//' | grep -qx "$latest"; then
        log "[$tool] $latest already installed"
    else
        log "[$tool] installing $latest (this can take a while for erlang/python)"
        asdf install "$tool" "$latest"
    fi
    asdf_set_global "$tool" "$latest"
    [ "$tool" = erlang ] && ERL_MAJOR=${latest%%.*}
    asdf reshim "$tool" >/dev/null 2>&1 || true
}

report_asdf() {
    log "asdf versions now active:"
    local t
    for t in "${ASDF_TOOLS[@]}"; do
        printf '  %-8s %s\n' "$t" "$(asdf current "$t" 2>/dev/null | awk 'NR==1 && $1=="Name"{next} {print $2; exit}')"
    done
}

setup_vscode() {
    need_apt "install VS Code manually" || return
    local keyring=/usr/share/keyrings/microsoft.gpg
    ensure_apt_repo vscode Microsoft vscode https://packages.microsoft.com/keys/microsoft.asc "$keyring" "gpg --dearmor" <<EOF
Types: deb
URIs: https://packages.microsoft.com/repos/code
Suites: stable
Components: main
Architectures: amd64,arm64,armhf
Signed-By: $keyring
EOF
    apt_install_or_upgrade vscode code
}

setup_sublime_merge() {
    need_apt "install Sublime Merge manually" || return
    local keyring=/etc/apt/keyrings/sublimehq-pub.asc
    ensure_apt_repo sublime-merge "Sublime HQ" sublime-text https://download.sublimetext.com/sublimehq-pub.gpg "$keyring" cat <<EOF
Types: deb
URIs: https://download.sublimetext.com/
Suites: apt/stable/
Signed-By: $keyring
EOF
    apt_install_or_upgrade sublime-merge sublime-merge
}

setup_gh() {
    need_apt "install the GitHub CLI manually" || return
    local keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg
    ensure_apt_repo gh GitHub github-cli https://cli.github.com/packages/githubcli-archive-keyring.gpg "$keyring" cat <<EOF
Types: deb
URIs: https://cli.github.com/packages
Suites: stable
Components: main
Signed-By: $keyring
EOF
    apt_install_or_upgrade gh gh
}

setup_flatpak() {
    need_apt "install flatpak manually" || return
    if ! have flatpak; then
        log "[flatpak] installing"
        as_root apt-get install -y flatpak
    fi
    if ! flatpak remotes --columns=name 2>/dev/null | grep -qx flathub; then
        log "[flatpak] adding flathub remote"
        as_root flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
    local app
    for app in "${FLATPAK_APPS[@]}"; do
        if flatpak info "$app" >/dev/null 2>&1; then
            log "[flatpak] $app installed, updating"
            as_root flatpak update -y --noninteractive "$app"
        else
            log "[flatpak] installing $app"
            as_root flatpak install -y --noninteractive flathub "$app"
        fi
    done
}

setup_claude() {
    local bin="$HOME/.local/bin/claude"
    if [ -L "$bin" ] && [[ "$(readlink -f "$bin")" == "$HOME/.local/share/claude/"* ]]; then
        log "[claude] installed, checking for updates"
        "$bin" update </dev/null || warn "[claude] update failed, continuing"
    elif have claude; then
        warn "[claude] managed elsewhere ($(command -v claude)), not touching it"
    else
        log "[claude] installing"
        run_remote_script https://claude.ai/install.sh bash </dev/null
    fi
}

# Run each enabled step through its setup_<step> function.
run_steps() {
    local step
    for step; do
        if [ "${ENABLED[$step]}" -eq 1 ]; then
            "setup_${step//-/_}"
        fi
    done
}

run_steps "${EARLY_STEPS[@]}"
ensure_asdf
for t in "${ASDF_TOOLS[@]}"; do manage_tool "$t"; done
run_steps "${LATE_STEPS[@]}"
report_asdf
log "Done."
